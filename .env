# Infrastructure (Docker Ports & Domain)
APP_DOMAIN=localhost
APP_PORT=8080
MYSQL_PORT=3306

# Database Access Config
MYSQL_ROOT_PASSWORD=secret_root_pass
MYSQL_DATABASE=yii2_db
MYSQL_USER=yii2_user
MYSQL_PASSWORD=yii2_password

# Application Settings
APP_ENV=dev
APP_DEBUG=true
APP_LANGUAGE=en-US

# Security Key (для cookie validation)
COOKIE_VALIDATION_KEY=some_random_long_string_for_security_12345
